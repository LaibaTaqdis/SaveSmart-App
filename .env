# ============================================
# SaveSmart Environment Variables (Sample)
# ============================================
# Copy this file to .env and fill in your own keys.
# Never commit .env to version control.
# ============================================

# --- Groq API (AI Quiz + Tip Generation) ---
# Get your key at: https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=insert_your_groq_api_key_here
EXPO_PUBLIC_GROQ_MODEL=llama-3.3-70b-versatile
EXPO_PUBLIC_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# --- Firebase Configuration ---
# Get these from Firebase Console > Project Settings > General > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=insert_your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- Google Sign-In (optional) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
